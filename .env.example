DATABASE_URL=postgresql://postgres:change-me@postgres:5432/oa_docs
RUNTIME_CONFIG_PATH=/app/config/runtime.json
REDIS_URL=redis://redis:6379/0
BASE_URL=http://localhost:18000
STORAGE_BACKEND=nas
NAS_HOST_PATH=/mnt/bank-oa
NAS_ROOT=/mnt/oa
# OA 的 /oa/files/2026/x.pdf 将映射为容器中的 /mnt/oa/2026/x.pdf。
# 同路径部署时留空此项，filerealpath 必须位于 NAS_ROOT 中。
NAS_PATH_PREFIX=/oa/files
NAS_FILES_ENCRYPTED=false
MAX_FILE_SIZE=104857600
DAT_HOST_PATH=/mnt/oa-dat
DAT_IMPORT_DIRECTORY=/data/dat_files
# 从0起计数，默认将 filerealpath 追加为第12列（原第1列仍跳过）。
DAT_FILEREALPATH_INDEX=11
DAT_IMPORT_UPDATE_EXISTING=false
DOCUMENT_PARSE_API_URL=http://document-parser:5000

# 行内 OpenAI 兼容网关；模型名填网关实际发布的 ID。
OPENAI_BASE_URL=http://your-internal-llm-host/v1
OPENAI_API_KEY=replace-with-internal-key
OPENAI_MODEL_NAME=replace-with-internal-deepseek-model-id
AI_JSON_OUTPUT_METHOD=response_format
AI_REQUEST_TIMEOUT=120
AI_ANALYSIS_MAX_LENGTH=50000

DIFY_BASE_URL=http://your-internal-dify-host
DIFY_API_KEY=replace-with-dataset-api-key
DIFY_DATASET_ID=replace-with-dataset-id
CLEANUP_AUTO_DELETE=false
CLEANUP_MIN_CONFIDENCE=95
CLEANUP_CONTEXT_CHARS=24000
CLEANUP_AI_RECHECK_DAYS=30
